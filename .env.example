# Copiez ce fichier en .env et remplissez les valeurs pour activer les vrais envois.
# Sans ce fichier, les SMS/emails sont simulés (journalisés en base + console),
# ce qui permet de faire fonctionner et démontrer le projet sans aucun compte payant.

PORT=4000
JWT_SECRET=changez-moi-en-production

# --- Email (optionnel) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre_utilisateur
SMTP_PASS=votre_mot_de_passe
SMTP_FROM="Sanlam Mrirt <no-reply@sanlam-mrirt.ma>"

# --- SMS via Twilio (optionnel) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
